defmodule <%= @web_module %>.Components.AlertDialog do
  @moduledoc false
  use <%= @web_module %>, :component

  import <%= @web_module %>.Components.Button

  @doc """
  A modal dialog that interrupts the user with important content and expects a response.

  ## Installation

      mix widgex.add alert_dialog

  Install the hook in your app.js:

      import { ..., Dialog, ... } from "widgex";

      let liveSocket = new LiveSocket("/live", Socket, {
        hooks: {
          ...,
          Dialog,
          ...
        },
      });

  ## Usage

      <.alert_dialog>
        <.alert_dialog_trigger>Open</.alert_dialog_trigger>
        <.alert_dialog_content>
          <.alert_dialog_header>
            <.alert_dialog_title>Are you absolutely sure?</.alert_dialog_title>
            <.alert_dialog_description>
              This action cannot be undone. This will permanently delete your account
              and remove your data from our servers.
            </.alert_dialog_description>
          </.alert_dialog_header>
          <.alert_dialog_footer>
            <.alert_dialog_cancel>Cancel</.alert_dialog_cancel>
            <.alert_dialog_action>Continue</.alert_dialog_action>
          </.alert_dialog_footer>
        </.alert_dialog_content>
      </.alert_dialog>

  """

  attr :id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog(assigns) do
    ~H"""
    <div
      id={@id}
      phx-hook="Dialog"
      data-role="alertdialog"
      data-close-on-interact-outside
      data-close-on-escape
      class={@class}
      {@rest}
    >
      {render_slot(@inner_block, @id)}
    </div>
    """
  end

  attr :parent_id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_trigger(assigns) do
    ~H"""
    <div id={"dialog:#{@parent_id}:trigger"} class={@class} {@rest}>
      {render_slot(@inner_block)}
    </div>
    """
  end

  attr :parent_id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_content(assigns) do
    ~H"""
    <div
      id={"dialog:#{@parent_id}:backdrop"}
      class="fixed inset-0 z-50 bg-black/80  data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0"
      hidden
    >
    </div>
    <div id={"dialog:#{@parent_id}:popper"}>
      <div
        id={"dialog:#{@parent_id}:content"}
        class={
          classes([
            "fixed left-[50%] top-[50%] z-50 data-[state=open]:grid w-full max-w-lg translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-6 shadow-lg duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-left-1/2 data-[state=closed]:slide-out-to-top-[48%] data-[state=open]:slide-in-from-left-1/2 data-[state=open]:slide-in-from-top-[48%] sm:rounded-lg",
            @class
          ])
        }
        {@rest}
        hidden
      >
        {render_slot(@inner_block)}
      </div>
    </div>
    """
  end

  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_header(assigns) do
    ~H"""
    <div class={classes(["flex flex-col space-y-2 text-center sm:text-left", @class])} {@rest}>
      {render_slot(@inner_block)}
    </div>
    """
  end

  attr :parent_id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_title(assigns) do
    ~H"""
    <div id={"dialog:#{@parent_id}:title"} class={classes(["text-lg font-semibold", @class])} {@rest}>
      {render_slot(@inner_block)}
    </div>
    """
  end

  attr :parent_id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_description(assigns) do
    ~H"""
    <div
      id={"dialog:#{@parent_id}:description"}
      class={classes(["text-sm text-muted-foreground", @class])}
      {@rest}
    >
      {render_slot(@inner_block)}
    </div>
    """
  end

  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_footer(assigns) do
    ~H"""
    <div
      class={classes(["flex flex-col-reverse sm:flex-row sm:justify-end sm:space-x-2", @class])}
      {@rest}
    >
      {render_slot(@inner_block)}
    </div>
    """
  end

  attr :parent_id, :string, default: "dialog"
  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_cancel(assigns) do
    ~H"""
    <.button
      variant="outline"
      id={"dialog:#{@parent_id}:close"}
      class={classes(["mt-2 sm:mt-0", @class])}
      {@rest}
    >
      {render_slot(@inner_block)}
    </.button>
    """
  end

  attr :class, :string, default: ""
  attr :rest, :global

  slot :inner_block, required: true

  def alert_dialog_action(assigns) do
    ~H"""
    <.button class={@class} {@rest}>
      {render_slot(@inner_block)}
    </.button>
    """
  end
end
